gitignore syntax, per-language (Node/Go) and editor artefacts.

# Dependencies
node_modules/
vendor/

# Builds / dist
dist/
build/
out/
*.tsbuildinfo

# Env & secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key

# Data / backups
*.sql
*.dump
backups/
data/

# Logs
*.log
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp